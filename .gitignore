# ============================================================
#  OrcaLab 双臂操作与数据采集 —— 忽略清单
#  原则：只入库「源码 + 配置 + 文档」；数据集、调试截图、
#        第三方源码、机器人二进制资产一律不入库。
# ============================================================

# ---------- 采集产出 / 数据集（单文件可超 100MB，GitHub 会硬拒） ----------
data/
scripts/collect/dataset/
*.hdf5
*.h5
*.zip

# ---------- 第三方 / 上游仓库（各自有独立仓库，只读参考） ----------
3rd-party/

# ---------- 机器人 prefab 资产（约 330MB 二进制网格/贴图） ----------
# 注意：必须写成 /assets/（只匹配仓库根目录）。
# 写成 assets/ 会连带忽略 scripts/teleop/assets/gripper_table.json ——
# 那是 orca_rig.py 运行时硬依赖的夹爪标定表，缺了直接崩。
/assets/

# ---------- 调试、临时、备份目录 ----------
backup/
_cam_test/
_cam_test2/
_cam_test3/
_diag/
_now/
_show/
output/

# ---------- 调试产出：截图与图像（共 341+ 张，约 230MB） ----------
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.mp4
*.avi

# ---------- 备份与参照文件 ----------
*.bak*
*.orig_ref
*.orig
*~
# Office / WPS 打开文档时生成的临时锁文件
~$*
.~lock.*#

# ---------- Python 缓存 / 运行日志 ----------
__pycache__/
*.py[cod]
.numba_cache/
.orca_logs/
*.log
.venv/
venv/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
